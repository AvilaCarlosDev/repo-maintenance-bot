# Repo Maintenance Bot — cron example
#
# Review and replace every path before installation.
# Start with dry-run and inspect the log.

# Daily dry-run at 08:30.
30 8 * * * REPO_MAINTENANCE_DRY_RUN=1 /home/USER/projects/repo-maintenance-bot/auto-commit.sh /home/USER/projects/my-project >> /home/USER/.local/state/repo-maintenance-bot/cron.log 2>&1

# After validating dry-run behavior, local commits can be enabled by removing
# REPO_MAINTENANCE_DRY_RUN=1. Push remains disabled unless explicitly enabled.
#
# 0 9 * * * /home/USER/projects/repo-maintenance-bot/auto-commit.sh /home/USER/projects/my-project >> /home/USER/.local/state/repo-maintenance-bot/cron.log 2>&1
