[Unit]
Description=Repo Maintenance Bot
Documentation=https://github.com/AvilaCarlosDev/repo-maintenance-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/repo-maintenance-bot
Environment=REPO_MAINTENANCE_DRY_RUN=1
ExecStart=/usr/bin/env bash %h/projects/repo-maintenance-bot/auto-commit.sh %h/projects/my-project
NoNewPrivileges=true
PrivateTmp=true
Nice=10

[Install]
WantedBy=default.target
